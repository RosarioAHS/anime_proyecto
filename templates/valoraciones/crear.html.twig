{% extends 'base.html.twig' %}

{% block title %}Valorar {{ pelicula.titulo }} - Studio Ghibli{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white">
                        <h3 class="mb-0">
                            <i class="fas fa-star me-2"></i>Valorar película
                        </h3>
                    </div>
                    <div class="card-body">
                        <!-- Información de la película -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                {% if pelicula.imagenUrl %}
                                    <img src="{{ pelicula.imagenUrl }}" class="img-fluid rounded" alt="{{ pelicula.titulo }}">
                                {% else %}
                                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded" style="height: 150px;">
                                        <i class="fas fa-film fa-3x"></i>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="col-md-9">
                                <h4>{{ pelicula.titulo }}</h4>
                                <p class="text-muted mb-1">
                                    <i class="fas fa-user-tie me-2"></i>{{ pelicula.director }}
                                </p>
                                {% if pelicula.anoLanzamiento %}
                                    <p class="text-muted mb-1">
                                        <i class="fas fa-calendar me-2"></i>{{ pelicula.anoLanzamiento }}
                                    </p>
                                {% endif %}
                            </div>
                        </div>

                        <hr>

                        <!-- Formulario de valoración -->
                        {{ form_start(form) }}

                        <div class="mb-4">
                            {{ form_label(form.puntuacion, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            <div class="rating-options">
                                {{ form_widget(form.puntuacion) }}
                            </div>
                            {{ form_errors(form.puntuacion) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.comentario, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.comentario) }}
                            {{ form_errors(form.comentario) }}
                            <small class="form-text text-muted">
                                Comparte tu opinión sobre esta película (opcional)
                            </small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-2"></i>Guardar valoración
                            </button>
                            <a href="{{ path('peliculas_show', {'id': pelicula.id}) }}" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </a>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% block stylesheets %}
        {{ parent() }}
        <style>
            .rating-options .form-check {
                padding: 10px;
                border: 1px solid #dee2e6;
                border-radius: 5px;
                margin-bottom: 10px;
                transition: all 0.3s;
            }
            .rating-options .form-check:hover {
                background-color: #f8f9fa;
                border-color: #667eea;
            }
            .rating-options .form-check-input:checked + .form-check-label {
                font-weight: bold;
                color: #667eea;
            }
        </style>
    {% endblock %}
{% endblock %}
