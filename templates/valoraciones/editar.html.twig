{% extends 'base.html.twig' %}

{% block title %}Editar valoración - {{ valoracion.pelicula.titulo }}{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-warning text-dark">
                        <h3 class="mb-0">
                            <i class="fas fa-edit me-2"></i>Editar valoración
                        </h3>
                    </div>
                    <div class="card-body">
                        <!-- Información de la película -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                {% if valoracion.pelicula.imagenUrl %}
                                    <img src="{{ valoracion.pelicula.imagenUrl }}" class="img-fluid rounded" alt="{{ valoracion.pelicula.titulo }}">
                                {% else %}
                                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded" style="height: 150px;">
                                        <i class="fas fa-film fa-3x"></i>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="col-md-9">
                                <h4>{{ valoracion.pelicula.titulo }}</h4>
                                <p class="text-muted mb-1">
                                    <i class="fas fa-user-tie me-2"></i>{{ valoracion.pelicula.director }}
                                </p>
                                <p class="text-muted mb-0">
                                    <i class="fas fa-clock me-2"></i>Valorado el {{ valoracion.creadoEn|date('d/m/Y') }}
                                </p>
                            </div>
                        </div>

                        <hr>

                        <!-- Formulario de edición -->
                        {{ form_start(form) }}

                        <div class="mb-4">
                            {{ form_label(form.puntuacion, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            <div class="rating-options">
                                {{ form_widget(form.puntuacion) }}
                            </div>
                            {{ form_errors(form.puntuacion) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.comentario, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.comentario) }}
                            {{ form_errors(form.comentario) }}
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save me-2"></i>Actualizar valoración
                            </button>
                            <a href="{{ path('peliculas_show', {'id': valoracion.pelicula.id}) }}" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </a>
                        </div>

                        {{ form_end(form) }}

                        <!-- Formulario de eliminación -->
                        <hr class="my-4">
                        <div class="alert alert-danger">
                            <h6><i class="fas fa-exclamation-triangle me-2"></i>Zona de peligro</h6>
                            <p class="mb-2">Si eliminas tu valoración, no podrás recuperarla.</p>
                            <form method="post" action="{{ path('valoraciones_eliminar', {'id': valoracion.id}) }}" onsubmit="return confirm('¿Estás seguro de eliminar esta valoración?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ valoracion.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash me-2"></i>Eliminar valoración
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% block stylesheets %}
        {{ parent() }}
        <style>
            .rating-options .form-check {
                padding: 10px;
                border: 1px solid #dee2e6;
                border-radius: 5px;
                margin-bottom: 10px;
                transition: all 0.3s;
            }
            .rating-options .form-check:hover {
                background-color: #f8f9fa;
                border-color: #ffc107;
            }
            .rating-options .form-check-input:checked + .form-check-label {
                font-weight: bold;
                color: #ffc107;
            }
        </style>
    {% endblock %}
{% endblock %}
