{% extends 'base.html.twig' %}

{% block title %}Estadísticas - Studio Ghibli{% endblock %}

{% block body %}
    <div class="container">
        <div class="row mb-4">
            <div class="col-md-8">
                <h1 class="text-white">
                    <i class="fas fa-chart-bar me-2"></i>Estadísticas Globales
                </h1>
                <p class="text-white-50">Consulta las estadísticas del sistema</p>
            </div>
            <div class="col-md-4 text-end">
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary">
                        <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                    </a>
                {% else %}
                    <a href="{{ path('peliculas_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Volver
                    </a>
                {% endif %}
            </div>
        </div>

        <!-- Estadística 1: Número total de valoraciones -->
        <div class="card shadow-lg mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-star me-2"></i>Número Total de Valoraciones
                </h5>
            </div>
            <div class="card-body text-center">
                <h1 class="display-3 text-primary">
                    {{ top_peliculas|reduce((carry, p) => carry + p.contadorRating, 0) }}
                </h1>
                <p class="text-muted mb-0">valoraciones realizadas en total</p>
            </div>
        </div>


        <div class="card shadow-lg mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="fas fa-calculator me-2"></i>Promedio de Puntuaciones por Categoría
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 offset-md-3 text-center">
                        <h3 class="mb-3">Categoría: Películas</h3>
                        {% set suma_ratings = 0 %}
                        {% set cantidad_peliculas = 0 %}
                        {% for pelicula in top_peliculas %}
                            {% if pelicula.contadorRating > 0 %}
                                {% set suma_ratings = suma_ratings + pelicula.promedioRating %}
                                {% set cantidad_peliculas = cantidad_peliculas + 1 %}
                            {% endif %}
                        {% endfor %}

                        {% if cantidad_peliculas > 0 %}
                            {% set promedio_categoria = suma_ratings / cantidad_peliculas %}
                            <div class="mb-3">
                                <h1 class="display-4 text-success">
                                    {{ promedio_categoria|number_format(2) }}
                                </h1>
                                <p class="text-muted">sobre 5 estrellas</p>
                            </div>

                            <!-- Mostrar estrellas visuales -->
                            <div class="text-warning" style="font-size: 2rem;">
                                {% for i in 1..5 %}
                                    {% if i <= promedio_categoria %}
                                        <i class="fas fa-star"></i>
                                    {% elseif i - 0.5 <= promedio_categoria %}
                                        <i class="fas fa-star-half-alt"></i>
                                    {% else %}
                                        <i class="far fa-star"></i>
                                    {% endif %}
                                {% endfor %}
                            </div>

                            <p class="text-muted mt-3">
                                Basado en {{ cantidad_peliculas }} películas valoradas
                            </p>
                        {% else %}
                            <p class="text-muted">No hay películas valoradas aún</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-lg mb-4">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">
                    <i class="fas fa-trophy me-2"></i>Películas Más Valoradas (Top 10)
                </h5>
            </div>
            <div class="card-body">
                {% if top_peliculas is empty %}
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-inbox fa-3x mb-3"></i>
                        <p>No hay películas valoradas todavía</p>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                            <tr>
                                <th style="width: 60px;">Posición</th>
                                <th>Película</th>
                                <th>Director</th>
                                <th class="text-center">Rating Promedio</th>
                                <th class="text-center">Nº Valoraciones</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for pelicula in top_peliculas %}
                                <tr>
                                    <td>
                                        <div class="text-center">
                                            {% if loop.index == 1 %}
                                                <i class="fas fa-medal text-warning fa-2x" title="1er lugar"></i>
                                            {% elseif loop.index == 2 %}
                                                <i class="fas fa-medal text-secondary fa-2x" title="2do lugar"></i>
                                            {% elseif loop.index == 3 %}
                                                <i class="fas fa-medal fa-2x" style="color: #cd7f32;" title="3er lugar"></i>
                                            {% else %}
                                                <span class="badge bg-primary">{{ loop.index }}</span>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td>
                                        <strong>{{ pelicula.titulo }}</strong>
                                    </td>
                                    <td>{{ pelicula.director }}</td>
                                    <td class="text-center">
                                        {% if pelicula.contadorRating > 0 %}
                                            <span class="text-warning">
                                                <i class="fas fa-star"></i> {{ pelicula.promedioRating|number_format(2) }}
                                            </span>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary">{{ pelicula.contadorRating }}</span>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Nota:</strong> Las estadísticas se actualizan automáticamente cada vez que un usuario valora una película.
        </div>
    </div>
{% endblock %}
