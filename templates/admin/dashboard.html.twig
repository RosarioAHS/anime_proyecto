{% extends 'base.html.twig' %}

{% block title %}Panel de Administración{% endblock %}

{% block body %}
    <div class="container">
        <div class="row mb-4">
            <div class="col">
                <h1 class="text-white">
                    <i class="fas fa-tachometer-alt me-2"></i>Panel de Administración
                </h1>
                <p class="text-white-50">Bienvenido al sistema de gestión</p>
            </div>
        </div>

        {# ===== TARJETAS DE TOTALES ===== #}
        <div class="row g-4 mb-4">
            <div class="col-md-2 col-sm-4">
                <div class="card shadow-lg text-white bg-primary h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-film fa-2x opacity-50 mb-2"></i>
                        <h2 class="card-title mb-0">{{ total_peliculas }}</h2>
                        <small>Películas</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2 col-sm-4">
                <div class="card shadow-lg text-white bg-success h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-users fa-2x opacity-50 mb-2"></i>
                        <h2 class="card-title mb-0">{{ total_usuarios }}</h2>
                        <small>Usuarios</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2 col-sm-4">
                <div class="card shadow-lg text-white bg-warning h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-star fa-2x opacity-50 mb-2"></i>
                        <h2 class="card-title mb-0">{{ total_valoraciones }}</h2>
                        <small>Valoraciones</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2 col-sm-4">
                <div class="card shadow-lg text-white bg-info h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-list fa-2x opacity-50 mb-2"></i>
                        <h2 class="card-title mb-0">{{ total_rankings }}</h2>
                        <small>Rankings</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2 col-sm-4">
                <div class="card shadow-lg text-white bg-secondary h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-folder fa-2x opacity-50 mb-2"></i>
                        <h2 class="card-title mb-0">{{ total_categorias }}</h2>
                        <small>Categorías</small>
                    </div>
                </div>
            </div>
        </div>

        {# ===== ACCESOS RÁPIDOS ===== #}
        <div class="row g-3 mb-4">
            <div class="col-12">
                <h4 class="text-white">
                    <i class="fas fa-bolt me-2"></i>Accesos Rápidos
                </h4>
            </div>
            <div class="col-md-3 col-sm-6">
                <a href="{{ path('admin_estadisticas') }}" class="btn btn-success w-100 py-3">
                    <i class="fas fa-chart-bar fa-2x d-block mb-1"></i>
                    Ver Estadísticas
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <a href="{{ path('admin_usuarios') }}" class="btn btn-warning w-100 py-3">
                    <i class="fas fa-users fa-2x d-block mb-1"></i>
                    Gestionar Usuarios
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <a href="{{ path('admin_categorias_index') }}" class="btn btn-secondary w-100 py-3">
                    <i class="fas fa-folder fa-2x d-block mb-1"></i>
                    Gestionar Categorías
                </a>
            </div>
        </div>

        {# ===== FILA PRINCIPAL ===== #}
        <div class="row g-4">

            {# Últimas valoraciones #}
            <div class="col-md-4">
                <div class="card shadow-lg h-100">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">
                            <i class="fas fa-clock me-2"></i>Últimas Valoraciones
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        {% if ultimas_valoraciones is empty %}
                            <div class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2"></i>
                                <p>No hay valoraciones aún</p>
                            </div>
                        {% else %}
                            <ul class="list-group list-group-flush">
                                {% for valoracion in ultimas_valoraciones %}
                                    <li class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong class="d-block">{{ valoracion.pelicula.titulo }}</strong>
                                                <small class="text-muted">
                                                    <i class="fas fa-user me-1"></i>{{ valoracion.usuario.nombreUsuario }}
                                                </small>
                                            </div>
                                            <div class="text-end">
                                            <span class="text-warning">
                                                <i class="fas fa-star"></i>
                                                {{ valoracion.puntuacion|number_format(1) }}
                                            </span>
                                                <br>
                                                <small class="text-muted">{{ valoracion.creadoEn|date('d/m/Y') }}</small>
                                            </div>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Usuarios más activos #}
            <div class="col-md-4">
                <div class="card shadow-lg h-100">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-trophy me-2"></i>Usuarios Más Activos
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        {% if usuarios_activos is empty %}
                            <div class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2"></i>
                                <p>No hay actividad aún</p>
                            </div>
                        {% else %}
                            <ul class="list-group list-group-flush">
                                {% for usuario in usuarios_activos %}
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            {% if loop.index == 1 %}
                                                <i class="fas fa-medal text-warning me-2"></i>
                                            {% elseif loop.index == 2 %}
                                                <i class="fas fa-medal text-secondary me-2"></i>
                                            {% elseif loop.index == 3 %}
                                                <i class="fas fa-medal me-2" style="color: #cd7f32;"></i>
                                            {% else %}
                                                <span class="badge bg-secondary me-2">{{ loop.index }}</span>
                                            {% endif %}
                                            {{ usuario.nombre }}
                                        </div>
                                        <span class="badge bg-success">
                                        {{ usuario.valoraciones }}
                                        <i class="fas fa-star ms-1"></i>
                                    </span>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Top películas #}
            <div class="col-md-4">
                <div class="card shadow-lg h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-star me-2"></i>Top Películas
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        {% if top_peliculas is empty %}
                            <div class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2"></i>
                                <p>No hay películas valoradas aún</p>
                            </div>
                        {% else %}
                            <ul class="list-group list-group-flush">
                                {% for pelicula in top_peliculas %}
                                    <li class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong class="d-block">{{ pelicula.titulo }}</strong>
                                                {% if pelicula.categoria %}
                                                    <span class="badge bg-primary" style="font-size: 0.7rem;">
                                                    {{ pelicula.categoria.nombre }}
                                                </span>
                                                {% endif %}
                                            </div>
                                            <div class="text-end">
                                            <span class="text-warning">
                                                <i class="fas fa-star"></i>
                                                {{ pelicula.promedioRating|number_format(1) }}
                                            </span>
                                                <br>
                                                <small class="text-muted">{{ pelicula.contadorRating }} votos</small>
                                            </div>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% block stylesheets %}
        {{ parent() }}
        <style>
            .opacity-50 { opacity: 0.5; }
        </style>
    {% endblock %}
{% endblock %}
