{% extends 'base.html.twig' %}

{% block title %}Panel de Administración{% endblock %}

{% block body %}
    <div class="container">
        <div class="row mb-4">
            <div class="col">
                <h1 class="text-white">
                    <i class="fas fa-tachometer-alt me-2"></i>Panel de Administración
                </h1>
                <p class="text-white-50">Bienvenido al sistema de gestión</p>
            </div>
        </div>

        <!-- Tarjetas de estadísticas -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card shadow-lg text-white bg-primary">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-subtitle mb-2">Total Películas</h6>
                                <h2 class="card-title mb-0">{{ total_peliculas }}</h2>
                            </div>
                            <div>
                                <i class="fas fa-film fa-3x opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-lg text-white bg-success">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-subtitle mb-2">Total Usuarios</h6>
                                <h2 class="card-title mb-0">{{ total_usuarios }}</h2>
                            </div>
                            <div>
                                <i class="fas fa-users fa-3x opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-lg text-white bg-warning">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-subtitle mb-2">Total Valoraciones</h6>
                                <h2 class="card-title mb-0">{{ total_valoraciones }}</h2>
                            </div>
                            <div>
                                <i class="fas fa-star fa-3x opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-lg text-white bg-info">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-subtitle mb-2">Total Rankings</h6>
                                <h2 class="card-title mb-0">{{ total_rankings }}</h2>
                            </div>
                            <div>
                                <i class="fas fa-list fa-3x opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Accesos rápidos -->
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card shadow-lg h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-film fa-3x text-primary mb-3"></i>
                        <h5 class="card-title">Gestionar Películas</h5>
                        <p class="card-text">Crear, editar o eliminar películas del catálogo</p>
                        <a href="{{ path('admin_peliculas') }}" class="btn btn-primary">
                            <i class="fas fa-cog me-2"></i>Gestionar
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-lg h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-chart-bar fa-3x text-success mb-3"></i>
                        <h5 class="card-title">Estadísticas</h5>
                        <p class="card-text">Ver estadísticas globales y gráficos del sistema</p>
                        <a href="{{ path('admin_estadisticas') }}" class="btn btn-success">
                            <i class="fas fa-chart-line me-2"></i>Ver Estadísticas
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-lg h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-users fa-3x text-warning mb-3"></i>
                        <h5 class="card-title">Gestionar Usuarios</h5>
                        <p class="card-text">Ver y administrar usuarios del sistema</p>
                        <a href="{{ path('admin_usuarios') }}" class="btn btn-warning">
                            <i class="fas fa-users-cog me-2"></i>Ver Usuarios
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% block stylesheets %}
        {{ parent() }}
        <style>
            .opacity-50 {
                opacity: 0.5;
            }
        </style>
    {% endblock %}
{% endblock %}
