{% extends 'base.html.twig' %}

{% block title %}Editar Ranking - Studio Ghibli{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-warning text-dark">
                        <h3 class="mb-0">
                            <i class="fas fa-edit me-2"></i>Editar Ranking
                        </h3>
                    </div>
                    <div class="card-body">

                        {# Mostrar categoría actual (no editable) #}
                        <div class="alert alert-secondary mb-3">
                            <i class="fas fa-folder me-2"></i>
                            Categoría: <strong>{{ ranking.categoria.nombre }}</strong>
                            <small class="text-muted ms-2">(no se puede cambiar)</small>
                        </div>

                        {{ form_start(form) }}

                        <div class="mb-3">
                            {{ form_label(form.nombreRanking, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.nombreRanking) }}
                            {{ form_errors(form.nombreRanking) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.descripcion, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.descripcion) }}
                            {{ form_errors(form.descripcion) }}
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                {{ form_widget(form.publico) }}
                                {{ form_label(form.publico, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save me-2"></i>Guardar cambios
                            </button>
                            <a href="{{ path('rankings_gestionar', {'id': ranking.id}) }}" class="btn btn-primary">
                                <i class="fas fa-list me-2"></i>Gestionar películas
                            </a>
                            <a href="{{ path('rankings_index') }}" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </a>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
