
{% extends 'base.html.twig' %}

{% block title %}Editar Ranking - Studio Ghibli{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-warning text-dark">
                        <h3 class="mb-0">
                            <i class="fas fa-edit me-2"></i>Editar Ranking
                        </h3>
                    </div>
                    <div class="card-body">
                        {{ form_start(form) }}

                        <div class="mb-3">
                            {{ form_label(form.nombreRanking, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.nombreRanking) }}
                            {{ form_errors(form.nombreRanking) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.descripcion, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.descripcion) }}
                            {{ form_errors(form.descripcion) }}
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                {{ form_widget(form.publico) }}
                                {{ form_label(form.publico) }}
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save me-2"></i>Guardar cambios
                            </button>
                            <a href="{{ path('rankings_show', {'id': ranking.id}) }}" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </a>
                        </div>

                        {{ form_end(form) }}

                        <!-- Zona de peligro -->
                        <hr class="my-4">
                        <div class="alert alert-danger">
                            <h6><i class="fas fa-exclamation-triangle me-2"></i>Zona de peligro</h6>
                            <p class="mb-2">Si eliminas este ranking, todas las películas dentro de él se perderán.</p>
                            <form method="post" action="{{ path('rankings_eliminar', {'id': ranking.id}) }}" onsubmit="return confirm('¿Estás seguro de eliminar este ranking? Esta acción no se puede deshacer.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-' ~ ranking.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash me-2"></i>Eliminar ranking
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
