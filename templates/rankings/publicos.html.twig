{% extends 'base.html.twig' %}

{% block title %}Rankings Públicos - Studio Ghibli{% endblock %}

{% block body %}
    <div class="container">
        <div class="row mb-4">
            <div class="col-md-8">
                <h1 class="text-white">
                    <i class="fas fa-globe me-2"></i>Rankings Públicos
                </h1>
                <p class="text-white-50">Descubre las listas de otros usuarios</p>
            </div>
            <div class="col-md-4 text-end">
                <a href="{{ path('rankings_index') }}" class="btn btn-primary">
                    <i class="fas fa-list me-2"></i>Mis rankings
                </a>
            </div>
        </div>

        {% if rankings is empty %}
            <div class="card shadow-lg">
                <div class="card-body text-center py-5">
                    <i class="fas fa-globe-americas fa-4x text-muted mb-3"></i>
                    <h4>No hay rankings públicos disponibles</h4>
                    <p class="text-muted">Sé el primero en crear un ranking público para compartir con la comunidad</p>
                    {% if app.user %}
                        <a href="{{ path('rankings_nuevo') }}" class="btn btn-success mt-3">
                            <i class="fas fa-plus me-2"></i>Crear ranking público
                        </a>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                {% for ranking in rankings %}
                    <div class="col">
                        <div class="card h-100 shadow-lg hover-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h5 class="card-title">{{ ranking.nombreRanking }}</h5>
                                    <span class="badge bg-success">
                                    <i class="fas fa-globe me-1"></i>Público
                                </span>
                                </div>

                                <p class="text-muted small mb-2">
                                    <i class="fas fa-user me-1"></i>{{ ranking.usuario.nombreUsuario }}
                                </p>

                                {% if ranking.descripcion %}
                                    <p class="card-text text-muted small">{{ ranking.descripcion }}</p>
                                {% endif %}

                                <div class="mb-3">
                                <span class="badge bg-primary">
                                    <i class="fas fa-film me-1"></i>{{ ranking.rankingPeliculas|length }} películas
                                </span>
                                    <small class="text-muted ms-2">
                                        <i class="fas fa-clock me-1"></i>{{ ranking.creadoEn|date('d/m/Y') }}
                                    </small>
                                </div>

                                <!-- Preview de películas -->
                                {% if ranking.rankingPeliculas|length > 0 %}
                                    <div class="d-flex gap-1 mb-3">
                                        {% for rp in ranking.rankingPeliculas|slice(0, 3) %}
                                            {% if rp.pelicula.imagenUrl %}
                                                <img src="{{ rp.pelicula.imagenUrl }}"
                                                     class="img-thumbnail"
                                                     style="width: 60px; height: 80px; object-fit: cover;"
                                                     title="{{ rp.pelicula.titulo }}">
                                            {% endif %}
                                        {% endfor %}
                                        {% if ranking.rankingPeliculas|length > 3 %}
                                            <div class="d-flex align-items-center justify-content-center bg-light rounded" style="width: 60px; height: 80px;">
                                                <span class="text-muted">+{{ ranking.rankingPeliculas|length - 3 }}</span>
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endif %}

                                <div class="d-grid">
                                    <a href="{{ path('rankings_show', {'id': ranking.id}) }}" class="btn btn-primary btn-sm">
                                        <i class="fas fa-eye me-1"></i>Ver ranking
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {% block stylesheets %}
        {{ parent() }}
        <style>
            .hover-card {
                transition: all 0.3s ease;
            }
            .hover-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 30px rgba(0,0,0,0.3) !important;
            }
        </style>
    {% endblock %}
{% endblock %}
